<%# A host's own launcher in the dock's tray: what support_desk's "Need
    help?" is, with a static panel, for the browser tests and the README's
    screenshots. %>
<%= chats_tray_item :help,
      label: "Need help?",
      title: "Help centre",
      icon: tag.svg(tag.path(d: "M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3M12 17h.01M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z"),
                    viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width": 2,
                    "stroke-linecap": "round", "stroke-linejoin": "round", focusable: "false"),
      badge: chats_tray_badge(count, id: "dummy_help_badge") do %>
  <div class="dummy-help" data-chats-tray-refresh>
    <p>Questions about an order, a payment or your account? We usually answer within a day.</p>
    <label for="dummy_help_question">Your question</label>
    <textarea id="dummy_help_question" rows="3"></textarea>
    <a href="/">Read the guides</a>
  </div>
<% end %>
