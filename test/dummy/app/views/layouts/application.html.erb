<!DOCTYPE html>
<html>
  <head>
    <%# A host that titles its pages from what they show, the way a layout
        reading @page_title or the controller's records does. %>
    <title><%= [@conversation&.title_for(current_user), "Dummy"].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= action_cable_meta_tag %>
    <%= javascript_importmap_tags %>
    <%= yield :head %>
  </head>
  <body>
    <%= yield %>

    <%# What the README tells a host to add: the dock renders for signed-in
        viewers, and on none of the engine's own pages — unless a browser
        test sets the `dock_everywhere` cookie (`everywhere: true`). %>
    <%= chats_dock(**@dock_options.to_h, everywhere: cookies[:dock_everywhere].present?) %>
  </body>
</html>
