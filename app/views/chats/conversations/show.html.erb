<%# The thread page under `config.inbox_layout = :stacked`: its header
    (chats/conversations/_thread_header) over the shared thread body
    (chats/conversations/_thread, which a floating dock window and the
    two-pane page's conversation pane render too — see that partial for how
    the live thread works). Under the default `:split`, /messages/:id is
    the two-pane page instead (index.html.erb). %>
<%= chats_styles %>

<%= render layout: "chats/conversations/thread",
           locals: {
             conversation: @conversation,
             messages: @messages,
             more: @more_messages,
             first_unread_id: @first_unread_id,
             counterpart: chats_counterpart,
             read_pending: @read_pending
           } do %>
  <%= render "chats/conversations/thread_header",
             conversation: @conversation, participant: @participant, counterpart: chats_counterpart %>
<% end %>
