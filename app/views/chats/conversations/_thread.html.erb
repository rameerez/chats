<%# The thread body: everything live about one open conversation, shared by
    the thread PAGE (show.html.erb), a floating dock WINDOW (window.html.erb)
    and the two-pane page's conversation PANE (_conversation_pane.html.erb).
    Rendered as a partial LAYOUT — `yield` is the header, which is the one
    thing they differ in: the page keeps its full header (back link, ⋯ menu),
    the window its compact one (minimize, close, open full page); the pane
    renders its header above the thread, outside it, and yields nothing.

    One conversation stream powers everything here: message
    append/replace/remove, the read-state payload, and typing pings. Bubbles
    arrive VIEWER-AGNOSTIC from shared broadcasts; the chats--thread Stimulus
    controller aligns own-vs-other by comparing each bubble's sender key
    against its `me` value (that's what makes one broadcast render work for
    every subscriber).

    The DOM ids (messages, composer, composer_errors, read_state, typing) are
    the targets the streams address, so a conversation is rendered at most
    ONCE per page: the dock never opens a window for a conversation the page
    already shows.

    Locals:
      conversation     the Chats::Conversation
      messages         the latest page, oldest first
      more             whether older pages exist (the lazy frame chain)
      first_unread_id  where the «new messages» line goes, or nil
      counterpart      the other messager of a direct thread, or nil
      window           true in a dock window: rooted at .chats-thread--window
                       (never .chats, which is the full-page shell), and the
                       server did NOT read this render — the controller
                       posts #read once the window is on screen and the
                       viewer is engaged with it (`readPending`).
      pane             true in the two-pane page's conversation pane: rooted
                       at .chats-thread--pane, inside the page's .chats shell.
      read_pending     the server did not read this render, so the
                       controller posts #read once the thread is on screen
                       (always true in a window; see
                       ConversationsController#show for when a page or a
                       pane is rendered unread).

    The page's root carries data-chats-dock-hide: the messaging dock hides
    itself on any page that has it. %>
<% window = local_assigns.fetch(:window, false) %>
<% pane = local_assigns.fetch(:pane, false) %>
<% read_pending = window || local_assigns.fetch(:read_pending, false) %>
<% viewer = chats_current_messager %>
<%# A direct thread nobody may write in any more says so up front, in the
    composer's place — the host's policy turned false, or the other account
    is gone — instead of letting a send fail. Same id as the composer, so
    the live lock swap still finds it. %>
<% refused = !conversation.locked? && conversation.direct? &&
             (counterpart.nil? || !Chats.can_message?(viewer, counterpart)) %>
<% root_class = if window then "chats-thread chats-thread--window"
                elsif pane then "chats-thread chats-thread--pane"
                else "chats chats-thread"
                end %>
<%= tag.div class: root_class, data: {
      controller: "chats--thread",
      "chats-dock-hide": (true unless window || pane), # the pane's page carries it
      "chats--thread-me-value": Chats.messager_key(viewer),
      "chats--thread-read-url-value": read_conversation_path(conversation),
      "chats--thread-read-pending-value": read_pending,
      "chats--thread-sent-label-value": t("chats.thread.sent"),
      "chats--thread-seen-label-value": Chats.config.read_receipts ? t("chats.thread.seen") : "",
      "chats--thread-today-label-value": t("chats.thread.today"),
      "chats--thread-yesterday-label-value": t("chats.thread.yesterday"),
      "chats--thread-typing-suffix-value": t("chats.thread.typing_suffix"),
      "chats--thread-group-value": conversation.group?,
      "chats--thread-refresh-url-value": refresh_conversation_path(conversation),
      "chats--thread-thread-url-value": conversation_path(conversation),
      "chats--thread-copied-label-value": t("chats.message.copied"),
      "chats--thread-menu-label-value": t("chats.message.menu"),
      # A plain data attribute (not a Stimulus value): host CSS/JS keys its
      # own block/report affordances off it. False for a messager declared
      # `acts_as_messager blockable: false`.
      "chats-blockable": chats_blockable?(counterpart),
      action: "pointerdown->chats--thread#pressStart pointermove->chats--thread#pressMove " \
              "pointerup->chats--thread#pressEnd pointercancel->chats--thread#pressCancel " \
              "contextmenu->chats--thread#contextMenu"
    } do %>

  <%= turbo_stream_from conversation %>

  <%= yield %>

  <%# tabindex: the arrow keys scroll the history (WCAG 2.1.1). The id is
      what the stale-thread catch-up re-renders when the thread fell more
      than a page behind (ConversationsController#refresh). %>
  <div id="<%= dom_id(conversation, :history) %>" class="chats-thread__scroll" data-chats--thread-target="scroller" tabindex="0">
    <%= render "chats/conversations/history", conversation: conversation, messages: messages, more: more,
                                              first_unread_id: first_unread_id, counterpart: counterpart,
                                              window: window %>
  </div>

  <%# Long-press popup (Telegram-style): the backdrop blurs the thread, the
      pressed bubble's clone morphs to the center, the reactions pill sits
      above it and the contextual menu below. Slots are filled by cloning
      the bubble's <template data-chats-message-menu>. %>
  <%# Modal on every screen (the backdrop covers the thread; a tap or a
      click on it closes): chats--thread keeps the focus inside while open. %>
  <div class="chats-popup"
       role="dialog"
       aria-modal="true"
       aria-label="<%= t("chats.message.menu") %>"
       data-chats--thread-target="popup"
       hidden>
    <div class="chats-popup__backdrop" data-action="click->chats--thread#closePopup"></div>
    <div class="chats-popup__stack">
      <div class="chats-popup__slot chats-popup__slot--reactions"
           data-chats--thread-target="popupReactions"
           data-action="click->chats--thread#popupMenuClicked"></div>
      <div class="chats-popup__slot chats-popup__slot--bubble" data-chats--thread-target="popupBubble"></div>
      <div class="chats-popup__slot chats-popup__slot--menu"
           data-chats--thread-target="popupMenu"
           data-action="click->chats--thread#popupMenuClicked"></div>
    </div>
  </div>

  <div class="chats-attachment-preview"
       role="dialog"
       aria-modal="true"
       tabindex="-1"
       data-chats--thread-target="attachmentDialog"
       data-action="keydown.esc->chats--thread#closeAttachment"
       hidden>
    <div class="chats-attachment-preview__surface"
         data-action="click->chats--thread#closeAttachmentFromBackdrop">
      <button type="button"
              class="chats-attachment-preview__close"
              aria-label="<%= t("chats.message.close_attachment") %>"
              data-action="chats--thread#closeAttachment">×</button>
      <figure class="chats-attachment-preview__figure">
        <img class="chats-attachment-preview__image"
             alt=""
             data-chats--thread-target="attachmentImage">
      </figure>
    </div>
  </div>

  <%# A locked conversation (its SUBJECT says so — Chats::ChatSubject#
      chat_locked?) keeps its whole history readable and swaps the composer
      for the reason it's closed. Never a hidden screen: gate the action,
      explain it in place. %>
  <% if conversation.locked? %>
    <%= render "chats/conversations/locked_composer", conversation: conversation %>
  <% elsif refused %>
    <%= render "chats/conversations/locked_composer", conversation: conversation,
                                                      notice: t("chats.flashes.blocked") %>
  <% else %>
    <%= render "chats/messages/composer", conversation: conversation %>
  <% end %>
<% end %>
