<%# The answer to a row click on the two-pane messaging page: the request
    comes from the page's `chats_conversation` frame (Turbo-Frame header),
    so the answer is that frame with the conversation pane in it and
    nothing else of the page — no list — inside the page's layout, whose
    <title> chats--split gives the tab (ConversationsController#show).
    Turbo swaps it into the frame and, the frame being
    data-turbo-action="advance", moves the address bar to /messages/:id. %>
<%= turbo_frame_tag Chats::ConversationsController::PANE_FRAME do %>
  <%= render "chats/conversations/conversation_pane",
             conversation: @conversation, participant: @participant,
             messages: @messages, more: @more_messages, first_unread_id: @first_unread_id,
             counterpart: chats_counterpart, read_pending: @read_pending %>
<% end %>
