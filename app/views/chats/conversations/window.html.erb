<%# A floating dock window's content (GET /:id?window=1 from inside the
    window's turbo frame — see chats/dock/_window for the frame and
    ConversationsController#show): the SAME thread body the page renders,
    rooted at .chats-thread--window, under the window's compact header.

    The header's chats--dock actions reach the dock's controller because the
    window lives inside the dock element. The title is a button: it
    minimizes and expands the window (LinkedIn's header click), and says
    which way with aria-expanded. %>
<% title = @conversation.title_for(chats_current_messager) %>
<%= turbo_frame_tag dom_id(@conversation, :window) do %>
  <section class="chats-window__card" role="region" aria-label="<%= t("chats.dock.window_label", name: title) %>">
    <%= render layout: "chats/conversations/thread",
               locals: {
                 conversation: @conversation,
                 messages: @messages,
                 more: @more_messages,
                 first_unread_id: @first_unread_id,
                 counterpart: chats_counterpart,
                 window: true
               } do %>
      <%= render "chats/dock/window_header", conversation: @conversation, title: title,
                                             counterpart: chats_counterpart %>
    <% end %>
  </section>
<% end %>
