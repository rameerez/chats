<%# One inbox row. Rendered per-viewer (this page only updates via full
    refreshes, never shared broadcasts, so viewer-specific state is fine here —
    unlike message bubbles, which must stay viewer-agnostic).

    `dock: true` (the messaging dock's recent list) keeps the link a link to
    the thread and marks it as a dock opener: a plain click opens the
    conversation's floating window instead. A muted conversation carries
    the bell-slash.

    `pane: true` (the two-pane messaging page) points the link at the
    page's conversation frame, which opens it beside the list on a wide
    screen; on a phone, and without JavaScript, the frame is disabled and
    the link opens the thread page. `current:` is the conversation the page
    has open: its row says so (aria-current="page", .chats-row--current).
    `filter:` is the list's search or stack (`q`, `with`), kept in the
    link: the list's refreshes re-request the page's URL, and must find the
    same list there. %>
<% current = local_assigns[:current] == conversation %>
<% filter = local_assigns[:pane] ? local_assigns.fetch(:filter, {}) : {} %>
<li class="<%= class_names("chats-row", "chats-row--unread": unread_count.positive?, "chats-row--current": current) %>">
  <%= link_to conversation_path(conversation, **filter), class: "chats-row__link",
        "aria-current": ("page" if current),
        data: (if local_assigns[:dock]
                 chats_dock_opener(conversation)
               elsif local_assigns[:pane]
                 { turbo_frame: Chats::ConversationsController::PANE_FRAME }
               end) do %>
    <%= chats_conversation_avatar(conversation, viewer) %>

    <span class="chats-row__body">
      <span class="chats-row__top">
        <%# The badge sits OUTSIDE the ellipsizing title so a long name
            truncates without ever eating the mark. Nil for an ordinary
            counterpart and for groups, so the row is unchanged. %>
        <span class="chats-row__name">
          <span class="chats-row__title"><%= conversation.title_for(viewer) %></span>
          <%= chats_verified_badge(conversation.counterpart_for(viewer)) %>
          <% if chats_muted?(conversation, viewer) %>
            <svg class="chats-row__muted" role="img" aria-label="<%= t("chats.dock.muted") %>" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                 focusable="false"><title><%= t("chats.dock.muted") %></title><path d="M13.7 21a2 2 0 0 1-3.4 0M18.6 13A17.9 17.9 0 0 1 18 8M6.3 6.3A5.9 5.9 0 0 0 6 8c0 7-3 9-3 9h14M18 8a6 6 0 0 0-9.3-5M3 3l18 18"/></svg>
          <% end %>
        </span>
        <time class="chats-row__time" datetime="<%= conversation.last_message_at&.iso8601 %>">
          <%= chats_timestamp(conversation.last_message_at) %>
        </time>
      </span>

      <% if conversation.subject_label %>
        <span class="chats-row__subject"><%= conversation.subject_label %></span>
      <% end %>

      <span class="chats-row__bottom">
        <span class="chats-row__preview"><%= chats_preview_for(conversation, viewer) %></span>
        <% if unread_count.positive? %>
          <span class="chats-badge"><%= unread_count > 99 ? "99+" : unread_count %></span>
        <% end %>
      </span>
    </span>
  <% end %>
</li>
