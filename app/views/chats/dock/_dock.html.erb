<%# The messaging dock (`chats_dock` in the host's layout): fixed to the
    bottom-right corner, LinkedIn / Steam style. Left to right, the floating
    conversation WINDOWS (newest nearest the panel), then the PANEL: its
    header is the collapsed bar (avatar, "Messages", unread badge), and open
    it holds search, the recent list and the way to the full inbox. On a
    phone (chats.css: under 700px wide or 500px tall) the closed bar is a
    round button, the open panel a full-screen sheet.

    data-turbo-permanent: Turbo Drive carries this element from page to page
    as it is — open windows, scroll positions, drafts and cable
    subscriptions included — as long as the next page renders a dock with
    the same id. The id names the VIEWER, so a visit that lands on another
    account's page (sign out and in, an account switcher) never matches and
    never carries one person's windows into another's page.

    The panel is a <details>: it opens and closes with no JavaScript at all,
    and its rows, search and links are real links and forms. The chats--dock
    controller (dock_controller.js) does the rest. Its live signal is the
    template on the viewer's own `[messager, :chats_dock]` stream (see
    chats/dock/_signal and Chats::Broadcasts). %>
<% key = Chats.messager_key(viewer) %>
<%= chats_styles %>
<%= tag.aside id: "chats_dock_#{key}",
      class: ["chats-dock", ("chats-dock--no-launcher" unless launcher)],
      "aria-label": t("chats.dock.title"),
      data: {
        turbo_permanent: true,
        chats_messager: key,
        controller: "chats--dock",
        "chats--dock-windows-value": windows,
        "chats--dock-messager-value": key,
        "chats--dock-everywhere-value": everywhere,
        "chats--dock-window-url-value": chats_routes.conversation_path("__id__", window: 1),
        "chats--dock-record-key-value": Chats::Conversation.model_name.param_key,
        "chats--dock-badge-url-value": chats_routes.badge_conversations_path,
        "chats--dock-announcement-value": t("chats.dock.new_message_from", name: "%{name}"),
        # Every plural form the locale has (CLDR: zero, one, two, few, many,
        # other), uninterpolated: the controller picks one with
        # Intl.PluralRules and fills %{count} in.
        "chats--dock-window-unread-value": chats_plural_forms("chats.dock.window_unread").to_json,
        action: "keydown->chats--dock#keydown " \
                "focusin->chats--dock#engage pointerdown->chats--dock#engage wheel->chats--dock#engage " \
                "touchstart->chats--dock#engage " \
                "turbo:before-fetch-response->chats--dock#frameResponded " \
                "turbo:frame-missing->chats--dock#frameMissing " \
                "turbo:frame-load->chats--dock#frameLoaded " \
                "turbo:fetch-request-error->chats--dock#frameFailed " \
                "turbo:submit-end->chats--dock#sent " \
                "input->chats--dock#typed " \
                "click@document->chats--dock#delegate " \
                "turbo:before-stream-render@document->chats--dock#beforeStreamRender " \
                "turbo:load@document->chats--dock#pageChanged turbo:render@document->chats--dock#pageChanged " \
                "turbo:frame-load@document->chats--dock#pageFrameLoaded"
      } do %>
  <%= turbo_stream_from viewer, :chats_dock %>
  <%= render "chats/dock/signal" %>

  <div id="chats_dock_windows" class="chats-dock__windows" data-chats--dock-target="windows"></div>

  <%# What a window shows before its thread arrives, and if it can't. %>
  <template data-chats--dock-target="loadingShell"><%= render "chats/dock/window_shell", state: :loading %></template>
  <template data-chats--dock-target="failedShell"><%= render "chats/dock/window_shell", state: :failed %></template>

  <details class="chats-dock__panel"
           data-chats--dock-target="panel"
           data-action="toggle->chats--dock#panelToggled">
    <%# The summary reads "Messages, 3 unread" from its own text; on a phone
        the closed one is the round launcher (chats.css). %>
    <summary class="chats-dock__bar chats-dock__toggle">
      <%= chats_messager_avatar(viewer) %>
      <svg class="chats-dock__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3Z" />
      </svg>
      <span class="chats-dock__title"><%= t("chats.dock.title") %></span>
      <%= render "chats/dock/badge", count: viewer.unread_chats_count %>
      <span class="chats-dock__chevron" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
             stroke-linejoin="round" focusable="false"><path d="m6 15 6-6 6 6" /></svg>
      </span>
      <span class="chats-dock__close-glyph" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
             focusable="false"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </span>
    </summary>

    <div class="chats-dock__body">
      <% if Chats.config.search %>
        <%# The inbox's own search: with JavaScript the results land in the
            dock's frame (the inbox answers that frame with the dock's list);
            without it, on the full inbox. %>
        <%= form_with url: chats_routes.conversations_path,
              method: :get,
              class: "chats-search chats-dock__search",
              # `html:`: form_with drops attributes it doesn't know (role among them).
              html: { role: "search" },
              data: {
                controller: "chats--debounced-submit",
                action: "input->chats--debounced-submit#queue search->chats--debounced-submit#queue",
                "chats--debounced-submit-delay-value": 250,
                turbo_frame: "chats_dock_list"
              } do %>
          <%= hidden_field_tag :recent, recent, id: nil %>
          <%= search_field_tag :q, nil,
                id: "chats_dock_q",
                placeholder: t("chats.inbox.search_placeholder"),
                "aria-label": t("chats.inbox.search_placeholder"),
                class: "chats-search__input",
                autocomplete: "off" %>
        <% end %>
      <% end %>

      <%# Lazy: nothing is fetched until the panel first opens; until then,
          four still rows. The controller reloads it when the signal says,
          and when its stream may have missed a signal. `refresh: :morph`:
          a reload morphs the rows in place, so the list keeps its scroll
          position, and it reloads its own src, so a search stays. %>
      <%= turbo_frame_tag "chats_dock_list",
            src: chats_routes.dock_conversations_path(recent: recent),
            loading: :lazy,
            refresh: :morph,
            target: "_top",
            class: "chats-dock__results",
            # A click here opens a window, never the page: hovering a row
            # must not prefetch it.
            data: { "chats--dock-target": "list", turbo_prefetch: false } do %>
        <div aria-busy="true" aria-label="<%= t("chats.thread.loading") %>">
          <% 4.times do %><div class="chats-dock__skeleton"><span></span></div><% end %>
        </div>
      <% end %>

      <%= link_to t("chats.dock.see_all"), chats_routes.conversations_path, class: "chats-dock__see-all" %>
      <%= chats_slot :dock_panel_footer, viewer: viewer %>
    </div>
  </details>

  <%# "New message from …": polite, one at a time. The badge is not live. %>
  <div class="chats-visually-hidden" aria-live="polite" aria-atomic="true" data-chats--dock-target="announcer"></div>
<% end %>
