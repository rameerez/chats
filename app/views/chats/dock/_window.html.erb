<%# A floating window's FRAME: an empty turbo frame that loads its thread
    from `?window=1` (conversations/window.html.erb). Appended to
    #chats_dock_windows by ConversationsController#create (`chat_button_to
    …, dock: true`); the dock's controller builds the identical element
    itself when a row or a live message opens one (dock_controller.js,
    buildWindow) — keep the two in step.

    `target: "_top"`: links inside a window (a name, an action button) open
    the page, never the frame. `data-focus`: opened by a click, so the
    composer takes the focus once the thread arrives. %>
<%= turbo_frame_tag dom_id(conversation, :window),
      src: chats_routes.conversation_path(conversation, window: 1),
      target: "_top",
      class: "chats-window",
      data: {
        "chats--dock-target": "window",
        conversation_id: conversation.id,
        focus: (true if local_assigns[:focus])
      } do %>
  <div class="chats-loader"><%= t("chats.thread.loading") %></div>
<% end %>
